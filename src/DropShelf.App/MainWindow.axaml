<Window
    x:Class="DropShelf.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
    Title="Drop Shelf"
    Width="420"
    Height="300"
    MinWidth="320"
    MinHeight="180"
    automation:AutomationProperties.Name="Drop Shelf">
  <Border Padding="24">
    <StackPanel Spacing="10">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Drop Shelf" />
      <TextBlock
          Name="EmptyShelfMessage"
          Text="Drop files, text, or URLs here"
          TextWrapping="Wrap" />
      <StackPanel Name="ShelfItems" Spacing="6" />
      <TextBlock
          Name="DropStatus"
          automation:AutomationProperties.Name="Drop status"
          Text="Ready for a drop."
          TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
